{
  "name": "@knoxcall/browser",
  "version": "0.1.1",
  "description": "KnoxCall in the browser, dependency-free: hosted fields that exchange a sensitive value for a vault token (the value never enters your page JavaScript), single-use-token reveal, and client-side kc: encryption. No API key in the page.",
  "homepage": "https://docs.knoxcall.com/sdks/elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnoxCall/sdk-browser.git",
    "directory": "knoxcall-browser"
  },
  "bugs": {
    "url": "https://github.com/KnoxCall/sdk-browser/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "keywords": ["knoxcall", "encryption", "tokenization", "webcrypto", "ecies"],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
