{
  "name": "@knoxcall/react",
  "version": "0.1.1",
  "description": "Hosted fields for React: <SecureField> embeds a KnoxCall-served iframe that captures one sensitive value and returns a vault token, so the value never enters your page JavaScript.",
  "homepage": "https://docs.knoxcall.com/sdks/elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnoxCall/sdk-browser.git",
    "directory": "knoxcall-react"
  },
  "bugs": {
    "url": "https://github.com/KnoxCall/sdk-browser/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "@knoxcall/browser": ">=0.1.0"
  },
  "devDependencies": {
    "@knoxcall/browser": "file:../knoxcall-browser",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "keywords": ["knoxcall", "react", "iframe", "elements", "tokenization"],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
